<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>GGN — Gurgaon Sector &amp; Transit Map</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0A0E1A;
    --bg-2:#0D1220;
    --panel:#101627;
    --panel-2:#0C1120;
    --hair:#1B2338;
    --hair-soft:#161D30;
    --text:#EDEFF4;
    --muted:#8891A6;
    --muted-2:#5E6980;

    --yellow:#F5B935;
    --rapid:#33C2B8;
    --office:#F03A55;
    --select:#FF6B5E;

    /* corridor accents — each maps to a real Gurgaon road corridor */
    --gcr:#7C9CFF;   /* Golf Course Road */
    --gcx:#5FD3A0;   /* Golf Course Extension Road */
    --shr:#FF9F5A;   /* Sohna Road */
    --dwe:#E85D75;   /* Dwarka Expressway */
    --spr:#B98CFF;   /* SPR / New Gurgaon */
    --neutral:#5B7396; /* Old Gurgaon / DLF / unaffiliated */

    --font-display:'Space Grotesk', sans-serif;
    --font-body:'Inter', sans-serif;
    --font-mono:'JetBrains Mono', monospace;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:
      radial-gradient(1100px 620px at 12% -8%, #101A30 0%, transparent 60%),
      radial-gradient(900px 560px at 100% 0%, #0E1526 0%, transparent 55%),
      var(--bg);
    color:var(--text);
    font-family:var(--font-body);
    display:flex;
    flex-wrap:wrap;
    min-height:100vh;
    animation:fadeIn .5s ease-out;
  }
  @keyframes fadeIn{ from{opacity:0} to{opacity:1} }
  @media (prefers-reduced-motion:reduce){ body{animation:none} }

  a{ color:inherit; }
  :focus-visible{ outline:2px solid var(--select); outline-offset:2px; border-radius:4px; }

  /* ---------- MAP SIDE ---------- */
  .map-wrap{ flex:1 1 660px; padding:26px 26px 20px; min-width:0; }

  .topbar{
    display:flex; align-items:flex-end; justify-content:space-between;
    flex-wrap:wrap; gap:14px; margin-bottom:6px;
    border-bottom:1px solid var(--hair-soft); padding-bottom:16px;
  }
  .brand{ display:flex; flex-direction:column; gap:2px; }
  .brand .mark{
    font-family:var(--font-display); font-weight:700; font-size:30px;
    letter-spacing:.5px; color:var(--text); display:flex; align-items:center; gap:10px;
  }
  .brand .mark .dot{ width:9px; height:9px; border-radius:50%; background:var(--yellow); box-shadow:0 0 10px var(--yellow); }
  .brand .sub{ font-size:12px; color:var(--muted); letter-spacing:.5px; }

  .stats{ display:flex; gap:10px; flex-wrap:wrap; }
  .stat{
    font-family:var(--font-mono); font-size:11px; color:var(--muted);
    background:var(--panel-2); border:1px solid var(--hair);
    padding:6px 10px; border-radius:20px; white-space:nowrap;
  }
  .stat b{ color:var(--text); font-weight:600; }

  .hint{ font-size:13px; color:var(--muted); margin:14px 0 14px; }

  .search-box{
    width:100%; padding:11px 14px; border-radius:10px;
    background:var(--panel-2); border:1px solid var(--hair); color:var(--text);
    font-family:var(--font-body); font-size:13.5px;
  }
  .search-box::placeholder{ color:var(--muted-2); }

  .map-frame{
    margin-top:14px;
    background:linear-gradient(180deg,var(--panel),var(--panel-2));
    border-radius:14px; padding:10px;
    border:1px solid var(--hair);
    box-shadow:0 20px 50px -25px rgba(0,0,0,.7);
  }
  svg{ width:100%; height:auto; display:block; border-radius:9px; }

  .sector-chip{ cursor:pointer; transition:filter .15s, transform .1s; }
  .sector-chip:hover{ filter:brightness(1.25); }
  .sector-chip.selected{ stroke:var(--select) !important; stroke-width:2.4; }
  .sector-num{
    font-family:var(--font-mono); font-weight:600; font-size:10.5px;
    text-anchor:middle; dominant-baseline:middle; pointer-events:none;
    fill:var(--text);
  }

  .metro-line{ stroke:var(--yellow); stroke-width:3.2; fill:none; stroke-linecap:round; }
  .rapid-line{ stroke:var(--rapid); stroke-width:3.2; fill:none; stroke-linecap:round; }
  .corridor-line{ fill:none; stroke-linecap:round; stroke-width:2.2; opacity:.5; }

  .station{
    fill:var(--panel); stroke-width:2.6; cursor:pointer; transition:filter .15s;
  }
  .station:hover{ filter:brightness(1.3); }
  .station.selected{ fill:var(--select); stroke:var(--select) !important; }
  .station-label{
    fill:var(--text); font-family:var(--font-body); font-weight:600; font-size:9.5px; pointer-events:none;
  }

  .office-pin{ fill:var(--office); stroke:#0A0E1A; stroke-width:1.4; cursor:pointer; }
  .office-marker:hover .office-pin{ filter:brightness(1.2); }
  .office-marker.selected .office-pin{ fill:#FFC93C; stroke:#FFC93C; }
  .office-label{ fill:#FFB3BE; font-family:var(--font-body); font-weight:700; font-size:9px; pointer-events:none; }

  .legend{
    display:flex; flex-wrap:wrap; gap:8px 18px; margin-top:16px;
    font-size:11.5px; color:var(--muted);
  }
  .legend .group{ display:flex; flex-wrap:wrap; gap:12px; align-items:center; }
  .legend .item{ display:flex; align-items:center; gap:6px; }
  .legend .sw{ width:15px; height:3px; border-radius:2px; display:inline-block; }
  .legend .dash{ background-image:linear-gradient(90deg, currentColor 60%, transparent 40%); background-size:6px 3px; height:2px; width:16px; }
  .legend .dot{ width:10px; height:10px; border-radius:50%; display:inline-block; border:2px solid var(--yellow); background:var(--panel); }
  .legend .dot.rapid{ border-color:var(--rapid); }
  .legend .diamond{ width:9px; height:9px; background:var(--office); transform:rotate(45deg); display:inline-block; }
  .legend .divider{ width:1px; align-self:stretch; background:var(--hair); }

  /* ---------- SIDEBAR ---------- */
  .sidebar{
    flex:1 1 320px; max-width:380px;
    background:var(--panel-2);
    padding:26px 22px;
    border-left:1px solid var(--hair);
  }
  .sidebar h2{
    font-family:var(--font-display); font-size:13px; letter-spacing:1.2px; text-transform:uppercase;
    color:var(--muted); margin:0 0 14px; font-weight:600;
  }
  .slot{
    border:1px solid var(--hair); border-radius:10px; padding:13px 15px; margin-bottom:10px;
    min-height:40px; display:flex; align-items:center; justify-content:space-between; gap:10px;
    background:var(--panel); transition:border-color .15s;
  }
  .slot .lead{ display:flex; align-items:center; gap:10px; min-width:0; }
  .slot .swatch{ width:8px; height:8px; border-radius:50%; flex:0 0 auto; }
  .slot .tag{ font-family:var(--font-mono); font-size:10px; color:var(--muted-2); letter-spacing:1px; flex:0 0 auto; }
  .slot .name{ font-size:13.5px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .slot.empty .name{ color:var(--muted); font-weight:400; font-style:italic; }
  .slot.filled{ border-color:var(--hair); }

  .result{ margin-top:20px; padding-top:19px; border-top:1px dashed var(--hair); }
  .result .label{ color:var(--muted); font-size:10.5px; letter-spacing:1.2px; font-family:var(--font-mono); }
  .result .big{ font-family:var(--font-display); font-size:30px; font-weight:700; color:var(--select); margin:5px 0; }
  .result .row{ display:flex; justify-content:space-between; font-size:13px; color:var(--muted); margin-top:6px; }
  .result .row b{ color:var(--text); font-family:var(--font-mono); font-weight:500; }

  .gmap-btn{
    display:flex; align-items:center; justify-content:center; gap:8px;
    width:100%; margin-top:16px; padding:13px;
    background:var(--yellow); color:#1A1200; text-align:center;
    text-decoration:none; font-weight:600; border-radius:10px; font-size:13.5px;
    font-family:var(--font-body); transition:filter .15s, transform .1s;
  }
  .gmap-btn:hover{ filter:brightness(1.08); transform:translateY(-1px); }

  .reset{
    margin-top:10px; background:none; border:1px solid var(--hair); color:var(--muted);
    padding:10px 12px; border-radius:8px; font-size:12px; cursor:pointer; width:100%;
    font-family:var(--font-body); transition:color .15s, border-color .15s;
  }
  .reset:hover{ color:var(--text); border-color:var(--muted-2); }

  .note{ margin-top:24px; font-size:11px; color:var(--muted-2); line-height:1.7; }
  .note strong{ color:var(--muted); }

  @media (max-width:760px){
    body{ flex-direction:column; }
    .sidebar{ max-width:100%; border-left:none; border-top:1px solid var(--hair); }
    .brand .mark{ font-size:24px; }
    .stats{ display:none; }
  }
</style>
</head>
<body>

<div class="map-wrap">
  <div class="topbar">
    <div class="brand">
      <div class="mark"><span class="dot"></span>GGN</div>
      <div class="sub">Sector map · metro · road corridors · Accenture offices</div>
    </div>
    <div class="stats" id="statsRow"></div>
  </div>

  <div class="hint">Tap any sector, station or red office marker. Pick two points for distance + a live Google Maps travel-time link.</div>

  <input class="search-box" id="searchBox" placeholder="Search — sector number, station, or corridor (e.g. 54, IFFCO, Sohna)…" />

  <div class="map-frame">
    <svg id="map" viewBox="0 0 900 860" xmlns="http://www.w3.org/2000/svg"></svg>
  </div>

  <div class="legend">
    <div class="group">
      <div class="item"><span class="sw" style="background:var(--yellow)"></span>Yellow Line</div>
      <div class="item"><span class="sw" style="background:var(--rapid)"></span>Rapid Metro</div>
      <div class="item"><span class="diamond"></span>Accenture office</div>
    </div>
    <div class="divider"></div>
    <div class="group" id="corridorLegend"></div>
  </div>
</div>

<div class="sidebar">
  <h2>Selected Points</h2>
  <div class="slot empty" id="slotA">
    <span class="lead"><span class="swatch" id="swA" style="background:transparent"></span><span class="name">Tap a point (A)</span></span>
    <span class="tag">A</span>
  </div>
  <div class="slot empty" id="slotB">
    <span class="lead"><span class="swatch" id="swB" style="background:transparent"></span><span class="name">Tap a point (B)</span></span>
    <span class="tag">B</span>
  </div>

  <div class="result" id="result" style="display:none">
    <div class="label">STRAIGHT-LINE DISTANCE</div>
    <div class="big" id="distVal">—</div>
    <div class="row"><span>Approx. road distance</span><b id="roadEst">—</b></div>
    <a class="gmap-btn" id="gmapLink" href="#" target="_blank" rel="noopener">Open live travel time in Google Maps →</a>
  </div>

  <button class="reset" onclick="resetSelection()">Reset selection</button>

  <div class="note">
    Layout is simplified/schematic, not to exact map scale — but coordinates are real, so distance figures and the Google Maps link are accurate. Colored lines group sectors by the real road corridor they sit on, the way Gurgaon is actually navigated when flat-hunting.
    <br><br>
    <strong>Red markers</strong> are Accenture's known Gurgaon campuses (DLF Cyber City, Candor TechSpace Sector 21, DLF World Tech Park Sector 30, SP Infocity Udyog Vihar). Tell me which is yours and I'll trim the rest.
  </div>
</div>

<script>
/* ---------------------------------------------------------------
   CORRIDORS — each real road corridor gets a color + an ordered
   run of sectors, drawn as a line (like a transit-map line).
   Old Gurgaon / DLF sectors don't sit on one linear road, so they
   get an accent color but no connecting line — accuracy over decoration.
----------------------------------------------------------------*/
const CORRIDORS = {
  GCR: {name:'Golf Course Road',        color:'var(--gcr)', hex:'#7C9CFF', order:['s42','s43','s53','s54','s55']},
  GCX: {name:'Golf Course Ext. Road',   color:'var(--gcx)', hex:'#5FD3A0', order:['s56','s57','s58','s61','s63','s65','s67']},
  SHR: {name:'Sohna Road',              color:'var(--shr)', hex:'#FF9F5A', order:['s38','s46','s47','s48','s49','s50','s51','s52']},
  DWE: {name:'Dwarka Expressway',       color:'var(--dwe)', hex:'#E85D75', order:['s99','s102','s104','s106','s109','s113']},
  SPR: {name:'SPR / New Gurgaon',       color:'var(--spr)', hex:'#B98CFF', order:['s70','s82','s83','s84','s88','s89','s90']},
