/* ---------------------------------------------------------------
   DATA — lat/lng only; screen position is computed automatically.
----------------------------------------------------------------*/
const points = [
  // ---- Metro: Yellow Line ----
  {id:'huda',   name:'HUDA City Centre', type:'metro', lat:28.4595, lng:77.0722},
  {id:'iffco',  name:'IFFCO Chowk',      type:'metro', lat:28.4736, lng:77.0724},
