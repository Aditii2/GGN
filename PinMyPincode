  {id:'s102', num:'102', area:'Dwarka Expressway', type:'sector', corridor:'DWE', lat:28.4850, lng:76.9950},
  {id:'s104', num:'104', area:'Dwarka Expressway', type:'sector', corridor:'DWE', lat:28.4900, lng:76.9900},
  {id:'s106', num:'106', area:'Dwarka Expressway', type:'sector', corridor:'DWE', lat:28.4950, lng:76.9850},
  {id:'s109', num:'109', area:'Dwarka Expressway', type:'sector', corridor:'DWE', lat:28.5000, lng:76.9800},
  {id:'s113', num:'113', area:'Dwarka Expwy (closest to Delhi)', type:'sector', corridor:'DWE', lat:28.5100, lng:76.9700},

  // ---- Accenture offices ----
  {id:'acc_cybercity', name:'Accenture — DLF Cyber City (Bldg 8)', type:'office', lat:28.4955, lng:77.0900},
  {id:'acc_candor',    name:'Accenture — Candor TechSpace, Sector 21', type:'office', lat:28.5100, lng:77.0728},
  {id:'acc_worldtech', name:'Accenture — DLF World Tech Park, Sector 30', type:'office', lat:28.4628, lng:77.0562},
  {id:'acc_udyog',     name:'Accenture — SP Infocity, Udyog Vihar Ph.1', type:'office', lat:28.5040, lng:77.0855},
];

/* ---------------------------------------------------------------
   PROJECTION
----------------------------------------------------------------*/
const VB_W = 900, VB_H = 860, PAD = 46;
const lats = points.map(p=>p.lat), lngs = points.map(p=>p.lng);
const latMin = Math.min(...lats), latMax = Math.max(...lats);
const lngMin = Math.min(...lngs), lngMax = Math.max(...lngs);

function project(lat,lng){
  return {
    x: PAD + (lng - lngMin) / (lngMax - lngMin) * (VB_W - PAD*2),
    y: PAD + (latMax - lat) / (latMax - latMin) * (VB_H - PAD*2)
  };
}
points.forEach(p=>{ const {x,y} = project(p.lat,p.lng); p.x = x; p.y = y; });
const byId = id => points.find(p=>p.id===id);

/* ---------------------------------------------------------------
   RENDER
----------------------------------------------------------------*/
const svg = document.getElementById('map');
const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
let selected = [];

function el(tag, attrs){
  const e = document.createElementNS('http://www.w3.org/2000/svg', tag);
  for(const k in attrs) e.setAttribute(k, attrs[k]);
  return e;
}
function makeInteractive(node, id){
  node.setAttribute('tabindex','0');
  node.setAttribute('role','button');
  node.addEventListener('click',()=>selectPoint(id));
  node.addEventListener('keydown',(e)=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); selectPoint(id); } });
}

// background grid
for(let gx=0; gx<=VB_W; gx+=36){ svg.appendChild(el('line',{x1:gx,y1:0,x2:gx,y2:VB_H,stroke:'#111726','stroke-width':1})); }
for(let gy=0; gy<=VB_H; gy+=36){ svg.appendChild(el('line',{x1:0,y1:gy,x2:VB_W,y2:gy,stroke:'#111726','stroke-width':1})); }

// corridor lines (drawn first, sit beneath everything)
Object.entries(CORRIDORS).forEach(([key, c])=>{
  const pts = c.order.map(id=>byId(id)).filter(Boolean);
  if(pts.length<2) return;
  const d = pts.map((p,i)=> (i===0?'M':'L')+p.x+','+p.y).join(' ');
  const path = el('path',{d, class:'corridor-line', stroke:c.hex, 'stroke-dasharray':'2 8'});
  svg.appendChild(path);
  if(!reduceMotion){
    const len = 400;
    const anim = el('animate',{
      attributeName:'stroke-dashoffset', from:len, to:0, dur:'14s', repeatCount:'indefinite'
    });
    path.appendChild(anim);
  }
});

// metro lines
function pathFor(order){ return order.map(id=>byId(id)).map((p,i)=> (i===0?'M':'L')+p.x+','+p.y).join(' '); }
svg.appendChild(el('path',{d:pathFor(['huda','iffco','mgroad','sikand','guru']), class:'metro-line'}));
svg.appendChild(el('path',{d:pathFor(['sikand','phase1','phase2','phase3']), class:'rapid-line'}));
svg.appendChild(el('path',{d:pathFor(['sikand','cyber','moulsari']), class:'rapid-line'}));

// sectors
points.filter(p=>p.type==='sector').forEach(p=>{
  const hex = p.corridor ? CORRIDORS[p.corridor].hex : '#5B7396';
  const label = p.num;
  const w = Math.max(30, 14 + label.length*9);
  const h = 26;
  const rect = el('rect',{
    x:p.x-w/2, y:p.y-h/2, width:w, height:h, rx:6,
    class:'sector-chip', 'data-id':p.id,
    fill:hex+'26', stroke:hex, 'stroke-width':1.3
  });
  makeInteractive(rect, p.id);
  svg.appendChild(rect);
  const t = el('text',{x:p.x, y:p.y+1, class:'sector-num'});
  t.textContent = label; t.style.pointerEvents='none';
  svg.appendChild(t);
});

// metro/rapid stations
points.filter(p=>p.type==='metro'||p.type==='rapid').forEach(p=>{
  const strokeColor = p.type==='rapid' ? 'var(--rapid)' : 'var(--yellow)';
  const c = el('circle',{cx:p.x, cy:p.y, r:8, class:'station'+(p.type==='rapid'?' rapid':''), 'data-id':p.id, stroke:strokeColor});
  makeInteractive(c, p.id);
  svg.appendChild(c);
  const label = el('text',{x:p.x+11, y:p.y-9, class:'station-label'});
  label.textContent = p.name;
  svg.appendChild(label);
});

// Accenture offices
points.filter(p=>p.type==='office').forEach(p=>{
  const g = el('g',{'data-id':p.id, class:'office-marker'});
  const diamond = el('path',{ d:`M ${p.x} ${p.y-11} L ${p.x+10} ${p.y} L ${p.x} ${p.y+11} L ${p.x-10} ${p.y} Z`, class:'office-pin' });
  const dot = el('circle',{cx:p.x, cy:p.y, r:3.2, fill:'#fff'});
  g.appendChild(diamond); g.appendChild(dot);
  makeInteractive(g, p.id);
  svg.appendChild(g);
  const label = el('text',{x:p.x+14, y:p.y+4, class:'office-label'});
  label.textContent = p.name.replace('Accenture — ','');
  svg.appendChild(label);
});

/* ---------------------------------------------------------------
   LEGEND + STATS (built from data, not hardcoded)
----------------------------------------------------------------*/
const corridorLegendEl = document.getElementById('corridorLegend');
Object.values(CORRIDORS).forEach(c=>{
  const div = document.createElement('div');
  div.className = 'item';
  div.innerHTML = `<span class="sw" style="background:${c.hex}"></span>${c.name}`;
  corridorLegendEl.appendChild(div);
});

const statsRow = document.getElementById('statsRow');
const nSectors = points.filter(p=>p.type==='sector').length;
const nStations = points.filter(p=>p.type==='metro'||p.type==='rapid').length;
const nOffices = points.filter(p=>p.type==='office').length;
statsRow.innerHTML = `
  <span class="stat"><b>${nSectors}</b> sectors</span>
  <span class="stat"><b>${nStations}</b> metro stops</span>
  <span class="stat"><b>${nOffices}</b> Accenture offices</span>
`;

/* ---------------------------------------------------------------
   SELECTION / DISTANCE / GOOGLE MAPS LINK
----------------------------------------------------------------*/
function haversine(a,b){
  const R = 6371;
  const dLat = (b.lat-a.lat)*Math.PI/180;
  const dLng = (b.lng-a.lng)*Math.PI/180;
  const lat1 = a.lat*Math.PI/180, lat2 = b.lat*Math.PI/180;
  const h = Math.sin(dLat/2)**2 + Math.cos(lat1)*Math.cos(lat2)*Math.sin(dLng/2)**2;
  return 2*R*Math.asin(Math.sqrt(h));
}
function swatchColor(p){
  if(p.type==='office') return 'var(--office)';
  if(p.type==='metro') return 'var(--yellow)';
  if(p.type==='rapid') return 'var(--rapid)';
  if(p.corridor) return CORRIDORS[p.corridor].hex;
  return '#5B7396';
}
function displayName(p){
  if(p.type==='sector') return (p.num.match(/^\d+$/) ? 'Sector '+p.num : p.num) + ' — ' + p.area;
  return p.name;
}

function selectPoint(id){
  if(selected.includes(id)){ selected = selected.filter(s=>s!==id); }
  else { if(selected.length>=2) selected.shift(); selected.push(id); }
  render();
}

function render(){
  document.querySelectorAll('.sector-chip, .station').forEach(elm=>{
    elm.classList.toggle('selected', selected.includes(elm.getAttribute('data-id')));
  });
  document.querySelectorAll('.office-marker').forEach(elm=>{
    elm.classList.toggle('selected', selected.includes(elm.getAttribute('data-id')));
  });

  const slotA = document.getElementById('slotA');
  const slotB = document.getElementById('slotB');
  const result = document.getElementById('result');
  const pA = byId(selected[0]);
  const pB = byId(selected[1]);

  slotA.className = pA ? 'slot filled' : 'slot empty';
  slotA.querySelector('.name').textContent = pA ? displayName(pA) : 'Tap a point (A)';
  document.getElementById('swA').style.background = pA ? swatchColor(pA) : 'transparent';

  slotB.className = pB ? 'slot filled' : 'slot empty';
  slotB.querySelector('.name').textContent = pB ? displayName(pB) : 'Tap a point (B)';
  document.getElementById('swB').style.background = pB ? swatchColor(pB) : 'transparent';

  if(pA && pB){
    const km = haversine(pA,pB);
    document.getElementById('distVal').textContent = km.toFixed(1)+' km';
    document.getElementById('roadEst').textContent = (km*1.35).toFixed(1)+' km';
    document.getElementById('gmapLink').href =
      `https://www.google.com/maps/dir/?api=1&origin=${pA.lat},${pA.lng}&destination=${pB.lat},${pB.lng}&travelmode=driving`;
    result.style.display = 'block';
  } else {
    result.style.display = 'none';
  }
}

function resetSelection(){ selected = []; render(); }

/* ---------------------------------------------------------------
   SEARCH
----------------------------------------------------------------*/
document.getElementById('searchBox').addEventListener('input', (e)=>{
  const q = e.target.value.trim().toLowerCase();
  const allNodes = svg.querySelectorAll('[data-id]');
  if(!q){ allNodes.forEach(n=>n.style.opacity='1'); return; }
  points.forEach(p=>{
    const corridorName = p.corridor ? CORRIDORS[p.corridor].name : '';
    const hay = [p.num,p.name,p.area,corridorName].filter(Boolean).join(' ').toLowerCase();
    const node = svg.querySelector(`[data-id="${p.id}"]`);
    if(node) node.style.opacity = hay.includes(q) ? '1' : '0.12';
  });
});
</script>
