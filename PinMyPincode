  // ---- Metro: Rapid Metro ----
  {id:'phase1', name:'Phase 1',    type:'rapid', lat:28.4776, lng:77.0947},
  {id:'phase2', name:'Phase 2',    type:'rapid', lat:28.4842, lng:77.0975},
  {id:'phase3', name:'Phase 3',    type:'rapid', lat:28.4886, lng:77.1012},
  {id:'cyber',  name:'Cyber City', type:'rapid', lat:28.4939, lng:77.0894},
  {id:'moulsari', name:'Moulsari Ave', type:'rapid', lat:28.4906, lng:77.0956},

  // ---- Sectors: Old Gurgaon / DLF belt (neutral — no linear corridor) ----
  {id:'s14', num:'14', area:'Old Gurgaon', type:'sector', lat:28.4675, lng:77.0378},
  {id:'s15', num:'15', area:'Old Gurgaon', type:'sector', lat:28.4711, lng:77.0450},
  {id:'s17', num:'17', area:'Old Gurgaon', type:'sector', lat:28.4630, lng:77.0505},
  {id:'s21', num:'21', area:'Dundahera · Rapid Metro', type:'sector', lat:28.4980, lng:77.0700},
  {id:'s22', num:'22', area:'Old Gurgaon', type:'sector', lat:28.4700, lng:77.0330},
  {id:'s23', num:'23', area:'Old Gurgaon', type:'sector', lat:28.4770, lng:77.0280},
  {id:'s24', num:'24', area:'DLF / Rapid Metro', type:'sector', lat:28.4970, lng:77.0850},
  {id:'s25', num:'25', area:'DLF / Rapid Metro', type:'sector', lat:28.4990, lng:77.0800},
  {id:'s28', num:'28', area:'DLF Phase 1 area', type:'sector', lat:28.4720, lng:77.1010},
  {id:'s29', num:'29', area:'Leisure Valley', type:'sector', lat:28.4661, lng:77.0656},
  {id:'s31', num:'31', area:'Old Gurgaon', type:'sector', lat:28.4580, lng:77.0587},
  {id:'dlf1', num:'DLF-1', area:'DLF Phase 1', type:'sector', lat:28.4780, lng:77.0980},
  {id:'dlf2', num:'DLF-2', area:'DLF Phase 2', type:'sector', lat:28.4820, lng:77.0940},
  {id:'dlf4', num:'DLF-4', area:'DLF Phase 4', type:'sector', lat:28.4650, lng:77.0930},
  {id:'dlf5', num:'DLF-5', area:'DLF Phase 5', type:'sector', lat:28.4520, lng:77.0980},
  {id:'udyog', num:'UV', area:'Udyog Vihar', type:'sector', lat:28.5050, lng:77.0870},

  // ---- Golf Course Road (GCR) ----
  {id:'s42', num:'42', area:'Golf Course Road', type:'sector', corridor:'GCR', lat:28.4460, lng:77.0930},
  {id:'s43', num:'43', area:'Golf Course Road', type:'sector', corridor:'GCR', lat:28.4485, lng:77.1010},
  {id:'s53', num:'53', area:'Golf Course Road', type:'sector', corridor:'GCR', lat:28.4430, lng:77.0960},
  {id:'s54', num:'54', area:'Golf Course Road', type:'sector', corridor:'GCR', lat:28.4370, lng:77.1050},
  {id:'s55', num:'55', area:'Golf Course Rd Extn', type:'sector', corridor:'GCR', lat:28.4300, lng:77.1030},

  // ---- Golf Course Extension Road (GCX) ----
  {id:'s56', num:'56', area:'Golf Course Ext Rd', type:'sector', corridor:'GCX', lat:28.4280, lng:77.1090},
  {id:'s57', num:'57', area:'Golf Course Ext Rd', type:'sector', corridor:'GCX', lat:28.4230, lng:77.1130},
  {id:'s58', num:'58', area:'Golf Course Ext Rd', type:'sector', corridor:'GCX', lat:28.4180, lng:77.1000},
  {id:'s61', num:'61', area:'Golf Course Ext Rd', type:'sector', corridor:'GCX', lat:28.4100, lng:77.1000},
  {id:'s63', num:'63', area:'Golf Course Ext Rd', type:'sector', corridor:'GCX', lat:28.4050, lng:77.1050},
  {id:'s65', num:'65', area:'Golf Course Ext Rd', type:'sector', corridor:'GCX', lat:28.3990, lng:77.1080},
  {id:'s67', num:'67', area:'Golf Course Ext Rd', type:'sector', corridor:'GCX', lat:28.3930, lng:77.1120},

  // ---- Sohna Road (SHR) ----
  {id:'s38', num:'38', area:'Near Medanta', type:'sector', corridor:'SHR', lat:28.4390, lng:77.0480},
  {id:'s46', num:'46', area:'Sohna Road', type:'sector', corridor:'SHR', lat:28.4300, lng:77.0600},
  {id:'s47', num:'47', area:'Sohna Road', type:'sector', corridor:'SHR', lat:28.4290, lng:77.0680},
  {id:'s48', num:'48', area:'Sohna Road', type:'sector', corridor:'SHR', lat:28.4220, lng:77.0580},
  {id:'s49', num:'49', area:'Sohna Road', type:'sector', corridor:'SHR', lat:28.4180, lng:77.0670},
  {id:'s50', num:'50', area:'Sohna Road', type:'sector', corridor:'SHR', lat:28.4150, lng:77.0700},
  {id:'s51', num:'51', area:'Sohna Road', type:'sector', corridor:'SHR', lat:28.4230, lng:77.0750},
  {id:'s52', num:'52', area:'Sohna Road', type:'sector', corridor:'SHR', lat:28.4130, lng:77.0620},

  // ---- SPR / New Gurgaon ----
  {id:'s70', num:'70', area:'SPR / New Gurgaon', type:'sector', corridor:'SPR', lat:28.3850, lng:77.1000},
  {id:'s82', num:'82', area:'SPR / Dwarka Expwy', type:'sector', corridor:'SPR', lat:28.4550, lng:77.0200},
  {id:'s83', num:'83', area:'Dwarka Expressway', type:'sector', corridor:'SPR', lat:28.4600, lng:77.0150},
  {id:'s84', num:'84', area:'Dwarka Expressway', type:'sector', corridor:'SPR', lat:28.4500, lng:77.0100},
  {id:'s88', num:'88', area:'New Gurgaon (commercial)', type:'sector', corridor:'SPR', lat:28.4400, lng:77.0000},
  {id:'s89', num:'89', area:'New Gurgaon (commercial)', type:'sector', corridor:'SPR', lat:28.4450, lng:76.9950},
  {id:'s90', num:'90', area:'New Gurgaon (affordable/mid)', type:'sector', corridor:'SPR', lat:28.4350, lng:76.9900},

  // ---- Dwarka Expressway (DWE) ----
